# 临时诊断：把注入后的源码交给 func_body，看判据读到的到底是什么
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from _gs_func import func_body

CMA = os.path.join(HERE, 'scripts', 'world', 'city_marker_art.gd')
orig = open(CMA, 'r', encoding='utf-8').read()

A6_OLD = ('\tif _tex_cache.has(key):\n\t\treturn _tex_cache[key] as Texture2D\n'
          '\t_ensure_map_index()\n')
A6_NEW = ('\t_ensure_map_index()\n'
          '\tif _tex_cache.has(key):\n\t\treturn _tex_cache[key] as Texture2D\n')

inj = orig.replace(A6_OLD, A6_NEW)
body = func_body(inj, '_try_texture') or ''
print('--- A6 注入后 _try_texture 体 ---')
print(repr(body))
rd = body.find('_tex_cache.has(key)')
ios = [p for p in (body.find('load('), body.find('_map_index.has'),
                   body.find('_type_index.has'), body.find('DirAccess')) if p >= 0]
print('rd=', rd, 'ios=', ios, '-> before_io =', rd >= 0 and (not ios or rd < min(ios)))

idx_c = func_body(inj, '_scan_dir_into') or ''
print('--- D0e 两阶段判定（未注入形态也先看）---')
print('found[base] in body:', 'found[base]' in idx_c)
print('for base in found.keys(): in body:', 'for base in found.keys():' in idx_c)
print('get_files pos:', idx_c.find('for f in dir.get_files():'),
      'keys pos:', idx_c.find('for base in found.keys():'))